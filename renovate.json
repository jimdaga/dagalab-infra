{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "argocd": {
    "managerFilePatterns": [
      "/argocd/apps/.+/application\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "argocd"
      ],
      "groupName": "{{depName}} chart",
      "addLabels": [
        "area/dependency"
      ]
    },
    {
      "description": "Plex tags are <version>.<build>-<hash>: order by version+build (the hash would otherwise read as a compatibility suffix and block every bump). Internet-facing: merge promptly.",
      "matchPackageNames": [
        "plexinc/pms-docker"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[0-9a-f]+$"
    },
    {
      "description": "Bookshelf tags are softcover-v<version>[.<build>]: keep the softcover- (Goodreads metadata) flavour and order by version+build.",
      "matchPackageNames": [
        "ghcr.io/pennydreadful/bookshelf"
      ],
      "versioning": "regex:^softcover-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(\\.(?<build>\\d+))?$"
    }
  ]
}
